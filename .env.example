# Nothing is required on Vercel: the site and API share one domain.
# Optional backend settings:
MAX_UPLOAD_MB=4
MAX_UPLOAD_ROWS=200000
MAX_WORKSPACES=4
WORKSPACE_TTL_MINUTES=90
LOG_LEVEL=INFO
# Only if the frontend is served from a different origin than the API:
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_REGEX=

# Frontend: leave empty for same-origin; set only if the API lives elsewhere.
VITE_API_URL=
